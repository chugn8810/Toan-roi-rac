#include <iostream>
#include <vector>
using namespace std;
int main() {
    int n;
    long long b;
    cin >> n >> b;
    vector<long long> tronglg(n), giatri(n);
    for(int i = 0; i < n; i++) {
        cin >> tronglg[i] >> giatri[i];
    }
    long long res = -1;
    vector<int> best(n, 0);
    for (int i = 0; i < (1 << n); i++) {
        long long current_w = 0;
        long long current_v = 0;
        vector<int> sudung(n);
        for (int j = 0; j < n; j++) {
            if ((i >> j) & 1) { 
                current_w += tronglg[j];
                current_v += giatri[j];
                sudung[j] = 1;
            } else {
                sudung[j] = 0;
            }
        }
        if (current_w <= b) {
            if (current_v > res) {
                res = current_v;
                best = sudung;
            }
        }
    }
    cout << res << endl;
    for (int i = 0; i < n; i++) {
        cout << best[i] << (i == n - 1 ? "" : " ");
    }
    return 0;
}
